      "get": {
        "tags": [
          "occupancy"
        ],
        "summary": "Get Occupancy Floors",
        "description": "Ketersediaan slot per lantai (UNKNOWN dihitung terpisah dari available).",
        "operationId": "get_occupancy_floors_api_v1_occupancy_floors_get",
        "parameters": [
          {
            "name": "x-device-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Device-Key"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
