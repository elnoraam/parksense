  "components": {
    "schemas": {
      "EntryTap": {
        "properties": {
          "gateId": {
            "type": "string",
            "title": "Gateid"
          },
          "cardId": {
            "type": "string",
            "title": "Cardid"
          },
          "vehicleType": {
            "type": "string",
            "title": "Vehicletype",
            "default": "MOTORCYCLE"
          },
          "tapTime": {
            "type": "string",
            "title": "Taptime"
          }
        },
        "type": "object",
        "required": [
          "gateId",
          "cardId",
          "tapTime"
        ],
        "title": "EntryTap"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "SlotStatusUpdate": {
        "properties": {
          "gatewayId": {
            "type": "string",
            "title": "Gatewayid"
          },
          "sensorType": {
            "type": "string",
            "title": "Sensortype"
          },
          "rawSensorValue": {
            "type": "number",
            "title": "Rawsensorvalue"
          },
          "unit": {
            "type": "string",
            "title": "Unit",
            "default": "cm"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "measuredAt": {
            "type": "string",
            "title": "Measuredat"
          }
        },
        "type": "object",
        "required": [
          "gatewayId",
          "sensorType",
          "rawSensorValue",
          "status",
          "measuredAt"
        ],
        "title": "SlotStatusUpdate"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}