      }
    },
    "/api/v1/dev/fault/recommendation": {
      "post": {
        "tags": [
          "dev"
        ],
        "summary": "Set Recommendation Fault",
        "description": "Paksa modul rekomendasi gagal (untuk TC-09). enabled=false untuk memulihkan.",
        "operationId": "set_recommendation_fault_api_v1_dev_fault_recommendation_post",
        "parameters": [
          {
            "name": "enabled",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true,
              "title": "Enabled"
            }
          },
          {
            "name": "x-device-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Device-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
