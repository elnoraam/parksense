    "/api/v1/ai/predictions/occupancy": {
      "get": {
        "tags": [
          "ai"
        ],
        "summary": "Get Occupancy Prediction",
        "description": "Prediksi okupansi per jam per lantai pada rentang jam (inklusif) beserta advisory.",
        "operationId": "get_occupancy_prediction_api_v1_ai_predictions_occupancy_get",
        "parameters": [
          {
            "name": "fromHour",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Fromhour"
            }
          },
          {
            "name": "toHour",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Tohour"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/dev/scenario/{name}": {
      "post": {
        "tags": [
          "dev"
        ],
        "summary": "Load Scenario",
        "description": "reset | peak_hour (lantai 1 hampir penuh, lantai 2 dibuka) | all_full | sensor_stale.",
        "operationId": "load_scenario_api_v1_dev_scenario__name__post",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Name"
            }
          },
          {
            "name": "x-device-key",
            "in": "header",
            "required": false,
